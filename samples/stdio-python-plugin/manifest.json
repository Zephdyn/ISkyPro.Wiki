{
  "pluginId": "top.iskypro.sample.python-stdio",
  "name": "ISkyPro Python stdio sample",
  "version": "0.1.0",
  "author": "ISkyPro",
  "description": "Python Plugin SDK v2 stdio-jsonrpc sample.",
  "protocolVersion": 2,
  "sdkVersion": "2.0.0",
  "transport": {
    "type": "stdio-jsonrpc",
    "stdio": {
      "command": "python",
      "args": [ "plugin.py", "--iskypro-stdio" ],
      "workingDirectory": ".",
      "environment": {}
    }
  },
  "supportedPlatforms": [
    { "platform": "windows", "architectures": [ "x64", "arm64" ] },
    { "platform": "linux", "architectures": [ "x64", "arm64" ] },
    { "platform": "osx", "architectures": [ "x64", "arm64" ] }
  ],
  "eventSubscriptions": [
    { "eventType": "message.created", "botAccountIds": [], "conversationIds": [] }
  ],
  "permissions": [ "messages.reply", "users.read" ],
  "commands": [
    {
      "name": "py",
      "aliases": [ "python" ],
      "prefixes": [ "/" ],
      "conversationScopes": [],
      "priority": 10
    }
  ],
  "filters": [],
  "concurrency": {
    "maxConcurrentEvents": 2,
    "queueCapacity": 32,
    "allowSameConversationConcurrency": false,
    "overflowPolicy": "reject-new"
  }
}
